{
  "name": "codemax",
  "version": "0.1.0",
  "description": "Rigorous Pi workflows built for codemode-only agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngcto/codemax.git"
  },
  "homepage": "https://github.com/ngcto/codemax#readme",
  "bugs": {
    "url": "https://github.com/ngcto/codemax/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codemode",
    "workflows"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "resources",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./resources/skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ported": "bun test scripts/ultracode/orch scripts/ultracode/watch-pr",
    "test:all": "npm run check && npm test && npm run test:ported"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "^1.0.4",
    "@earendil-works/pi-mcp": "^1.0.4",
    "commander": "14.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@types/node": "^24.0.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.5"
  }
}
